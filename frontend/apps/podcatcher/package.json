{
  "name": "@protocast/podcatcher",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@protocast/shared": "workspace:*",
    "expo": "~57.0.20",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.3"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-config-universe": "^0.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
